{
  "name": "unreleasd-presence-helper",
  "version": "1.0.10",
  "description": "Electron helper for Discord Rich Presence integration",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsc && electron .",
    "build:app": "tsc",
    "build": "npm run build:app && electron-builder --config electron-builder.config.js",
    "pack": "npm run build:app && electron-builder --dir --config electron-builder.config.js",
    "dist:mac": "npm run build:app && electron-builder --mac --config electron-builder.config.js",
    "dist:mac:arm64": "npm run build:app && electron-builder --mac --arm64 --config electron-builder.config.js",
    "dist:mac:x64": "npm run build:app && electron-builder --mac --x64 --config electron-builder.config.js",
    "dist:win": "npm run build:app && electron-builder --win --x64 --ia32 --config electron-builder.config.js",
    "dist:linux": "npm run build:app && electron-builder --linux --config electron-builder.config.js",
    "dist:all": "npm run build:app && electron-builder -mwl --config electron-builder.config.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:app && node --test tests/*.test.js"
  },
  "keywords": [
    "electron",
    "discord",
    "rich-presence"
  ],
  "author": {
    "name": "unreleased.world",
    "email": "support@unreleased.world"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.1.2",
    "dotenv": "^16.4.0",
    "zod": "^3.22.0"
  },
  "homepage": "https://unreleased.world",
  "repository": {
    "type": "git",
    "url": "https://github.com/0k0k113/aura.git"
  }
}
